# docker compose uchun sozlamalar. Nusxa oling: cp .env.example .env  (.env GitHub'ga yuklanmaydi)

# Majburiy
POSTGRES_PASSWORD=
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
# Kamida 8 belgi, taxmin qilib bo'lmaydigan
ADMIN_PASSWORD=

# AI (sun'iy intellekt tushuntirish, AI o'qituvchi, subtitr)
OPENAI_API_KEY=

# Ixtiyoriy: Azure o'zbekcha ovoz (bo'lmasa — bepul Edge ovozi)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Serverga joylashtirilganda (domen bilan)
# CLIENT_URL=https://imkon.uz
# PUBLIC_API_URL=https://api.imkon.uz/api
