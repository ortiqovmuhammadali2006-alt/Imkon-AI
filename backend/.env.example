PORT=5000
CLIENT_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=imkon_ai

# Majburiy: kamida 32 belgili tasodifiy qiymat. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Birinchi admin (migratsiya vaqtida yaratiladi). Parol kamida 8 belgi, namuna parol qabul qilinmaydi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# OpenAI (o'quvchi panelida AI tushuntirish va ovozli o'qish)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Microsoft Azure Speech — tabiiy o'zbekcha ovoz (oyiga 500 000 belgigacha bepul)
# Ovozlar: uz-UZ-MadinaNeural (ayol), uz-UZ-SardorNeural (erkak)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=uz-UZ-MadinaNeural

# Bepul o'zbekcha ovoz (Microsoft Edge). Azure kaliti bo'lmasa shu ishlatiladi. off - o'chirish
EDGE_TTS_VOICE=uz-UZ-MadinaNeural
# EDGE_TTS=off
# Madina ishlamasa OpenAI ovoziga o'tish (boshqa ovoz). Standart: o'chiq
# TTS_OPENAI_FALLBACK=on

# ---- Ixtiyoriy chegaralar (ko'rsatilmasa — standart qiymat) ----
# CLIENT_URL vergul bilan bir nechta manzil bo'lishi mumkin: https://imkon.uz,https://www.imkon.uz
# PASSWORD_MIN_LENGTH=8
# LOGIN_MAX_ATTEMPTS=10        # muvaffaqiyatsiz urinishlar, LOGIN_WINDOW_MIN daqiqa ichida
# LOGIN_WINDOW_MIN=15
# UPLOAD_MAX_MB=100
# AVATAR_MAX_MB=5
# FILE_URL_TTL_HOURS=12        # yuklangan fayl havolasi amal qilish muddati
# LIMIT_AI_REQUESTS=30         # 10 daqiqada, bitta foydalanuvchi
# LIMIT_CHAT_REQUESTS=40
# LIMIT_STT_REQUESTS=60
# LIMIT_TTS_CHARS=40000
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TRANSCRIBE_MODEL=whisper-1
